# ==========================================
# O.M.N.I.S Environment Configuration Example
# Duplicate this file as '.env' and fill in your keys
# ==========================================

# User and Assistant Configuration
Username=Sir
Assistantname=OMNIS
AssistantVoice=en-US-AriaNeural

# API Keys
# Cohere API Key for Query Decision-Making Model (FirstLayerDMM)
# Get your free key at: https://dashboard.cohere.com/
CohereAPIKey=your_cohere_api_key_here

# Groq API Key for Fast Chatbot & Realtime Search Reasoning (Llama 3)
# Get your free key at: https://console.groq.com/
GroqAPIKey=your_groq_api_key_here

# Hugging Face API Key for Stable Diffusion Image Generation
# Get your free key at: https://huggingface.co/settings/tokens
HuggingFaceAPIKey=your_huggingface_api_key_here
DECOHERE_AI=your_decohere_key_here
